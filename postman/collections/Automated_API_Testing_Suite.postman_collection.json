    {
      "name": "04_Negative_Scenarios",
      "description": "Negative testing scenarios verifying proper HTTP error codes and descriptive error structures.",
      "item": [
        {
          "name": "Login - Invalid Credentials (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Response body contains Unauthorized error structure\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "    pm.expect(jsonData.error).to.eql(\"Unauthorized\");",
                  "    pm.expect(jsonData.statusCode).to.eql(401);",
