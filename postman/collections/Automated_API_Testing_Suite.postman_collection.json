  "item": [
    {
      "name": "01_Health_and_Discovery",
      "description": "Service health check and environment discovery requests.",
      "item": [
        {
          "name": "Health Check - Service Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Status code validation",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Response time validation (SLA < 300ms)",
                  "pm.test(\"Response time is under 300ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(300);",
                  "});",
                  "",
                  "// Content-Type validation",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "// Response structure and data validation",
                  "pm.test(\"Response body has valid health status and fields\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "    pm.expect(jsonData.service).to.be.a(\"string\");",
                  "    pm.expect(jsonData.version).to.be.a(\"string\");",
                  "    pm.expect(jsonData.timestamp).to.be.a(\"string\");",
                  "    pm.expect(jsonData.uptime).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifies that the API service is up and running healthy."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02_Authentication",
      "description": "User authentication endpoints and token extraction.",
      "item": [
        {
          "name": "Login - Valid Admin Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Status code validation",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Response time validation (SLA < 500ms)",
                  "pm.test(\"Response time is under 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "// Token schema and response structure validation",
                  "pm.test(\"Response returns valid Bearer token and user profile\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"token\");",
                  "    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(jsonData.expiresIn).to.eql(\"24h\");",
                  "    pm.expect(jsonData.user).to.be.an(\"object\");",
                  "    pm.expect(jsonData.user.id).to.be.a(\"number\");",
                  "    pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"adminEmail\"));",
                  "    pm.expect(jsonData.user.role).to.eql(\"admin\");",
                  "",
                  "    // Store token in environment for authenticated requests",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates the admin user and stores the Bearer token in the environment."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03_Users_Positive_CRUD",
      "description": "Complete lifecycle CRUD positive test scenarios for the Users resource.",
      "item": [
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 400ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(400);",
                  "});",
                  "",
                  "pm.test(\"Response contains user list array and total count\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"total\");",
                  "    pm.expect(jsonData.total).to.be.a(\"number\").and.be.at.least(1);",
                  "    pm.expect(jsonData.users).to.be.an(\"array\").and.not.empty;",
                  "",
                  "    // Validate first user record structure",
                  "    const firstUser = jsonData.users[0];",
                  "    pm.expect(firstUser).to.have.property(\"id\").that.is.a(\"number\");",
                  "    pm.expect(firstUser).to.have.property(\"name\").that.is.a(\"string\");",
                  "    pm.expect(firstUser).to.have.property(\"email\").that.is.a(\"string\");",
                  "    pm.expect(firstUser).to.have.property(\"role\").that.is.a(\"string\");",
                  "    pm.expect(firstUser).to.have.property(\"status\").that.is.a(\"string\");",
                  "    pm.expect(firstUser).to.have.property(\"createdAt\").that.is.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Retrieves the list of existing users."
          },
          "response": []
        },
        {
          "name": "Create User - Positive",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique email to guarantee repeatability",
                  "const uniqueId = Date.now();",
                  "const generatedEmail = `qa.engineer.${uniqueId}@example.com`;",
                  "pm.environment.set(\"createdEmail\", generatedEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test(\"Created user matches request payload and has generated ID\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "    pm.expect(jsonData.id).to.be.a(\"number\").and.be.above(0);",
                  "    pm.expect(jsonData.name).to.eql(\"Automation Test User\");",
                  "    pm.expect(jsonData.email).to.eql(pm.environment.get(\"createdEmail\"));",
                  "    pm.expect(jsonData.role).to.eql(\"qa_engineer\");",
                  "    pm.expect(jsonData.status).to.eql(\"active\");",
                  "    pm.expect(jsonData.createdAt).to.be.a(\"string\");",
                  "    pm.expect(jsonData.updatedAt).to.be.a(\"string\");",
                  "",
                  "    // Save ID for subsequent lifecycle requests",
                  "    pm.environment.set(\"userId\", jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Automation Test User\",\n  \"email\": \"{{createdEmail}}\",\n  \"role\": \"qa_engineer\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Creates a new user record with dynamic test data."
          },
          "response": []
        },
        {
          "name": "Get User By ID - Positive",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 300ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(300);",
                  "});",
