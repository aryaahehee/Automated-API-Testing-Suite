                  "pm.test(\"Returned user data matches the created user ID and email\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const expectedId = Number(pm.environment.get(\"userId\"));",
                  "    const expectedEmail = pm.environment.get(\"createdEmail\");",
                  "",
                  "    pm.expect(jsonData.id).to.eql(expectedId);",
                  "    pm.expect(jsonData.email).to.eql(expectedEmail);",
                  "    pm.expect(jsonData.name).to.eql(\"Automation Test User\");",
                  "    pm.expect(jsonData.role).to.eql(\"qa_engineer\");",
                  "});"
                ],
